# Proofhold configuration. Copy to .env.local for local development.

# Base URL used in buyer links and PayPal return URLs.
APP_URL=http://127.0.0.1:3200

# Secret used to sign the workspace cookie and buyer tokens. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# Storage: "sqlite" (default, files under .data/) or "postgres" (requires DATABASE_URL).
PROOFHOLD_STORE=sqlite
# DATABASE_URL=postgres://user:pass@host:5432/proofhold

# PayPal. "sandbox" talks to api-m.sandbox.paypal.com. "simulated" runs an in-process
# simulator with the same state rules so the app works without credentials; the UI
# badges simulated mode everywhere.
PAYPAL_MODE=simulated
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Sandbox buyer used by scripts/create-sandbox-dispute.ts (never needed by the app).
# PAYPAL_BUYER_EMAIL=
# PAYPAL_BUYER_PASSWORD=

# The model behind the compiler and the examiner. Set ONE of the two keys: an Anthropic
# key (https://console.anthropic.com/settings/keys) or a Gemini key
# (https://aistudio.google.com/apikey). AI_PROVIDER=auto uses whichever key is set and
# prefers Anthropic when both are; set it to "anthropic" or "gemini" to force one.
# Without a key the compiler produces starter tests from the brief's plain facts.
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried once when the primary Gemini model is overloaded or rate-limited; the verdict
# records which model answered. Leave blank to fail instead of falling back.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# The examiner follows EXAMINER_MODE: "auto" uses the model when a key is set and is
# otherwise off; "simulated" runs a deterministic stand-in that is labelled as simulated
# on every verdict (for demos without a key); "off" sends judgement lines to the buyer.
EXAMINER_MODE=auto

# Mail. "simulated" (default) composes every notification into the outbox shown in
# Settings and sends nothing. "resend" sends through Resend (https://resend.com/docs)
# using RESEND_API_KEY; MAIL_FROM must be a sender on a domain verified with Resend.
MAIL_PROVIDER=simulated
# RESEND_API_KEY=
# MAIL_FROM=Proofhold <proofhold@yourdomain.example>

# Scheduler: "inline" runs reauthorization, silence windows and reconciliation inside
# the web process; "external" expects a cron to call /api/internal/tick with TICK_SECRET.
PROOFHOLD_SCHEDULER=inline
# TICK_SECRET=

# Demo settings. Silence windows are shortened to this many minutes when set.
# DEMO_SILENCE_MINUTES=2

# Logging: one JSON line per request and error, secrets redacted. debug | info | warn | error.
LOG_LEVEL=info
