# Proofhold configuration. Copy to .env.local for local development.

# Base URL used in buyer links and PayPal return URLs.
APP_URL=http://127.0.0.1:3200

# Secret used to sign the workspace cookie and buyer tokens. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# Storage: "sqlite" (default, files under .data/) or "postgres" (requires DATABASE_URL).
PROOFHOLD_STORE=sqlite
# DATABASE_URL=postgres://user:pass@host:5432/proofhold

# PayPal. "sandbox" talks to api-m.sandbox.paypal.com. "simulated" runs an in-process
# simulator with the same state rules so the app works without credentials; the UI
# badges simulated mode everywhere.
PAYPAL_MODE=simulated
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Sandbox buyer used by scripts/create-sandbox-dispute.ts (never needed by the app).
# PAYPAL_BUYER_EMAIL=
# PAYPAL_BUYER_PASSWORD=

# Anthropic. Without a key the compiler and examiner report themselves unavailable and
# the UI falls back to manual acceptance tests and buyer confirmation.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Scheduler: "inline" runs reauthorization, silence windows and reconciliation inside
# the web process; "external" expects a cron to call /api/internal/tick with TICK_SECRET.
PROOFHOLD_SCHEDULER=inline
# TICK_SECRET=

# Demo settings. Silence windows are shortened to this many minutes when set.
# DEMO_SILENCE_MINUTES=2
